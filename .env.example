# Copy this file to .env and adjust as needed. All values are optional; sensible
# defaults are baked into backend/config.py.

# Where Ollama is listening and which model to use.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Web server bind address. Keep 127.0.0.1 to stay local-only.
HOST=127.0.0.1
PORT=5000

# Retrieval / conversation tuning.
TOP_K=4
MAX_HISTORY=8
MAX_MESSAGE_CHARS=4000
NUM_CTX=4096
LLM_TIMEOUT=180
